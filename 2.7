public class JavaLiteralsDemo {

    public static void main(String[] args) {

        // Integer literals
        int number = 3;
        long population = 1000000L;

        // Floating-point literals
        float radius = 3.1415F;
        double price = 99.99;

        // Character literals
        char letter = 'A';
        char symbol = '#';

        // String literals
        String message = "Hello World";
        String lines = "two\nlines";
        String quote = "\"This is in quotes\"";

        // Boolean literals
        boolean answer = true;
        boolean choice = false;

        // Display the values
        System.out.println("Integer literal: " + number);
        System.out.println("Long literal: " + population);
        System.out.println("Float literal: " + radius);
        System.out.println("Double literal: " + price);
        System.out.println("Character literal: " + letter);
        System.out.println("Symbol character: " + symbol);
        System.out.println("String literal: " + message);

        System.out.println("String with new line:");
        System.out.println(lines);

        System.out.println("String with quotation marks:");
        System.out.println(quote);

        System.out.println("Boolean answer: " + answer);
        System.out.println("Boolean choice: " + choice);
    }
}