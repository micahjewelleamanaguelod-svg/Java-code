public class JavaDataTypesDemo {

    public static void main(String[] args) {

        // Logical data type
        boolean result = true;

        // Character data type
        char choice = 'a';
        char number = '1';

        // String data type
        String message = "Hello world!";

        // Integral data types
        byte smallNumber = 100;
        short mediumNumber = 10000;
        int wholeNumber = 100000;
        long largeNumber = 100000L;

        // Floating-point data types
        float price = 15.50F;
        double decimalNumber = 123.4;

        // Display the values
        System.out.println("Boolean value: " + result);
        System.out.println("Character value: " + choice);
        System.out.println("Character number: " + number);
        System.out.println("String value: " + message);
        System.out.println("Byte value: " + smallNumber);
        System.out.println("Short value: " + mediumNumber);
        System.out.println("Integer value: " + wholeNumber);
        System.out.println("Long value: " + largeNumber);
        System.out.println("Float value: " + price);
        System.out.println("Double value: " + decimalNumber);
    }
}Boolean value: true
Character value: a
Character number: 1
String value: Hello world!
Byte value: 100
Short value: 10000
Integer value: 100000
Long value: 100000
Float value: 15.5
Double value: 123.4
